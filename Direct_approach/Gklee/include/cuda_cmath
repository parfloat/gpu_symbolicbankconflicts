// Minimal cmath header for GKLEE compatibility
// This header provides the std:: namespace functions for CUDA code
#ifndef _GKLEE_CMATH_
#define _GKLEE_CMATH_

// For non-CUDA compilation, we need the full C++ cmath header
// We use the real path to the system cmath to avoid recursive includes
#include <stdlib.h>
#include <math.h>

namespace std {
    using ::sin;
    using ::cos;
    using ::tan;
    using ::asin;
    using ::acos;
    using ::atan;
    using ::atan2;
    using ::sinh;
    using ::cosh;
    using ::tanh;
    using ::exp;
    using ::log;
    using ::log10;
    using ::pow;
    using ::sqrt;
    using ::ceil;
    using ::floor;
    using ::fabs;
    using ::fmod;
    using ::frexp;
    using ::ldexp;
    using ::modf;

    using ::sinf;
    using ::cosf;
    using ::tanf;
    using ::asinf;
    using ::acosf;
    using ::atanf;
    using ::atan2f;
    using ::sinhf;
    using ::coshf;
    using ::tanhf;
    using ::expf;
    using ::logf;
    using ::log10f;
    using ::powf;
    using ::sqrtf;
    using ::ceilf;
    using ::floorf;
    using ::fabsf;
    using ::fmodf;

    // Provide abs overloads for floating point types
    inline float abs(float x) { return fabsf(x); }
    inline double abs(double x) { return fabs(x); }
    inline long double abs(long double x) { return fabsl(x); }
    inline int abs(int x) { return ::abs(x); }
    inline long abs(long x) { return ::labs(x); }
    inline long long abs(long long x) { return ::llabs(x); }
}

#endif // _GKLEE_CMATH_
